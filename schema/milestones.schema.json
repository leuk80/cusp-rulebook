{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cusp/cusp-rulebook/schema/milestones.schema.json",
  "title": "Milestone Set",
  "description": "Config-driven rewards unlocked at metric thresholds above/alongside status (Extra Benefits, Suite Night Upgrades, Milestone Rewards). Mirrors `MilestoneSet`/`Milestone` in QualificationEngine/Milestone.swift. File convention: `<id>.milestones.json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programId",
    "milestones"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "programId": {
      "type": "string",
      "minLength": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    }
  },
  "$defs": {
    "earningSource": {
      "enum": [
        "stay",
        "flight",
        "purchase",
        "purchasedNights",
        "statusCard",
        "promotion",
        "statusMatch",
        "partner",
        "manualAdjustment"
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metricId",
        "trigger",
        "choose",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metricId": {
          "type": "string",
          "minLength": 1,
          "description": "Which metric standing drives this milestone."
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "requiredTierId": {
          "type": "string",
          "minLength": 1,
          "description": "Only active while this exact tier is held."
        },
        "eligibleSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/earningSource"
          }
        },
        "choose": {
          "type": "boolean",
          "description": "true = choose 1 of options; false = all auto-granted."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reward"
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ],
          "properties": {
            "type": {
              "const": "thresholds"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "step",
            "end"
          ],
          "properties": {
            "type": {
              "const": "interval"
            },
            "start": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "end": {
              "type": "number"
            }
          }
        }
      ]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "labelKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "labelKey": {
          "type": "string",
          "minLength": 1,
          "description": "Localized in the app."
        },
        "giftable": {
          "type": "boolean"
        },
        "grantsKind": {
          "enum": [
            "suiteNightUpgrade",
            "freeNightCertificate",
            "upgradeVoucher",
            "loungePass",
            "other"
          ]
        },
        "grantsQuantity": {
          "type": "integer",
          "minimum": 0
        },
        "expiry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endOfYearsAhead"
          ],
          "description": "Declarative expiry for the granted benefit: lapses at the end of (issue year + endOfYearsAhead).",
          "properties": {
            "endOfYearsAhead": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
